<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.DishFlavorMapper">
    <resultMap id="FlavorResultMap" type="com.sky.entity.DishFlavor">
        <id column="id" property="id"/>
        <result column="dish_id" property="dishId"/>
        <result column="name" property="name"/>
        <result column="value" property="value"/>
    </resultMap>
	
	<!-- 根据菜品id删除口味 -->
    <delete id="deleteByDishId">
        delete from dish_flavor where dish_id = #{dishId}
    </delete>
	
	<!-- 根据菜品id查询口味 -->
    <select id="getByDishId" resultMap="FlavorResultMap">
        select * from dish_flavor where dish_id = #{dishId}
    </select>
</mapper>
