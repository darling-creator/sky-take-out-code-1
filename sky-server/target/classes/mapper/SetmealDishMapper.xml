<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.SetmealDishMapper">
    <resultMap id="SetmealDishResultMap" type="com.sky.entity.SetmealDish">
        <id column="id" property="id"/>
        <result column="setmeal_id" property="setmealId"/>
        <result column="dish_id" property="dishId"/>
        <result column="name" property="name"/>
        <result column="price" property="price"/>
        <result column="copies" property="copies"/>
    </resultMap>
	
	<!-- 批量新增套餐菜品 -->
    <insert id="insertBatch">
        insert into setmeal_dish(setmeal_id,dish_id,name,price,copies)
        <foreach collection="list" item="item" separator="union all">
            select #{item.setmealId},#{item.dishId},#{item.name},#{item.price},#{item.copies} from dual
        </foreach>
    </insert>
	
	<!-- 根据套餐id删除所有关联菜品 -->
    <delete id="deleteBySetmealId">
        delete from setmeal_dish where setmeal_id = #{setmealId}
    </delete>
	
	<!-- 根据套餐id查询套餐菜品 -->
    <select id="getBySetmealId" resultMap="SetmealDishResultMap">
        select * from setmeal_dish where setmeal_id = #{setmealId}
    </select>
</mapper>
